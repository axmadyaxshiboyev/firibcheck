# Ixtiyoriy: AI qo'shimcha tahlili uchun Anthropic API kaliti.
# Bo'sh qoldirilsa, sayt faqat qoidalarga asoslangan tahlil bilan ishlaydi (to'liq ishlaydi).
# Kalit faqat serverda ishlatiladi va brauzerga hech qachon yuborilmaydi.
ANTHROPIC_API_KEY=

# Ixtiyoriy: model nomi (standart: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ixtiyoriy: kunlik umumiy AI so'rovlari chegarasi (xarajatni cheklash). Standart: 2000
AI_DAILY_LIMIT=2000

# Ixtiyoriy, tavsiya etiladi (AI yoqilsa): limitlar serverless instansiyalar orasida umumiy bo'lishi uchun Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
